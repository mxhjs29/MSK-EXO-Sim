<?xml version="1.0"?>
<mujoco model="ElbowExoskeleton">
  <compiler angle="radian" meshdir="."/>
  <default>
    <default class="exo_visual">
      <geom type="mesh" contype="0" conaffinity="0" condim="3" group="0" rgba="1 1 1 1"/>
    </default>
    <default class="exo_elbow">
      <joint type="hinge" limited="true" damping="0.05" armature="1e-5"/>
    </default>
  </default>
  <asset>
    <mesh name="exo_right_upper_mesh" file="meshes/right_upper_exo.STL"/>
    <mesh name="exo_right_lower_mesh" file="meshes/right_lower_exo.STL"/>
    <mesh name="exo_left_upper_mesh" file="meshes/left_upper_exo.STL"/>
    <mesh name="exo_left_lower_mesh" file="meshes/left_lower_exo.STL"/>
  </asset>
  <worldbody>
    <!-- The two roots are attached to humerus_r/l by the device config. -->
    <include file="assets/exoskeleton_chain.xml"/>
  </worldbody>
</mujoco>
